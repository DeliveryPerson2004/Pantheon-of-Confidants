DEEPSEEK_API_KEY=
# Gexep A2A 服务默认只监听本机。容器部署可设为 0.0.0.0。
PANTHEON_HOST=127.0.0.1
PANTHEON_PORT=3000
# Internal peer A2A endpoint. It always binds to 127.0.0.1 and is never the public API.
PANTHEON_INTERNAL_PORT=3001
# 对外地址，用于 Agent Card 中的 supportedInterfaces.url。
PANTHEON_PUBLIC_URL=http://127.0.0.1:3000
# 可选；设置后，A2A RPC 要求 Authorization: Bearer <token>。
PANTHEON_API_TOKEN=
# UI 可连接另一台机器公开的 Gexep Agent Card。
PANTHEON_A2A_CARD_URL=http://127.0.0.1:3000/.well-known/agent-card.json
E2B_API_KEY=
# 可选；连接一个仍在运行或已暂停的 Jezeh Sandbox。未配置时会新建 Sandbox。
E2B_MEMO_SANDBOX_ID=
SMTP_PASS=
